{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "_comment": "Used ONLY as a fallback if Consul is unreachable. The real config lives in Consul KV at config/api-gateway.",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:8080"
    ]
  },
  "Jwt": {
    "Issuer": "incleanhome",
    "Audience": "incleanhome-api"
  },
  "ReverseProxy": {
    "Routes": {
      "iam-auth-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "iam-admin-users-route": {
        "Order": 1,
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/v1/admin/users/{**catch-all}"
        }
      },
      "payment-admin-settings-route": {
        "Order": 1,
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/admin/settings/{**catch-all}"
        }
      },
      "payment-admin-settings-root": {
        "Order": 1,
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/admin/settings"
        }
      },
      "iam-admin-route": {
        "Order": 10,
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        }
      },
      "iam-iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/v1/iam/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/iam"
          }
        ]
      },
      "profile-internal-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/profiles/{**catch-all}"
        }
      },
      "profile-clients-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/clients/{**catch-all}"
        }
      },
      "profile-workers-me-profile-route": {
        "Order": 1,
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/workers/me/profile"
        }
      },
      "profile-workers-me-photo-route": {
        "Order": 1,
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/workers/me/photo"
        }
      },
      "search-workers-route": {
        "Order": 10,
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/api/v1/workers/{**catch-all}"
        }
      },
      "search-workers-root-route": {
        "Order": 10,
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/api/v1/workers"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/bookings/{**catch-all}"
        }
      },
      "payment-service-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/service-payments/{**catch-all}"
        }
      },
      "payment-methods-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payments/methods/{**catch-all}"
        }
      },
      "payment-methods-root-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payments/methods"
        }
      },
      "payment-mercadopago-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payments/mercadopago/{**catch-all}"
        }
      },
      "communication-messages-route": {
        "ClusterId": "communication-cluster",
        "Match": {
          "Path": "/api/v1/messages/{**catch-all}"
        }
      },
      "communication-notifications-route": {
        "ClusterId": "communication-cluster",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/v1/reviews/{**catch-all}"
        }
      },
      "reviews-reports-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/v1/reports/{**catch-all}"
        }
      },
      "reviews-appeals-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/v1/suspension-appeals/{**catch-all}"
        }
      },
      "reviews-report-appeals-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/v1/report-appeals/{**catch-all}"
        }
      },
      "iam-users-public-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "iam-1": {
            "Address": "http://iam-service:5001/"
          }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-1": {
            "Address": "http://profile-service:5002/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-1": {
            "Address": "http://booking-service:5003/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-1": {
            "Address": "http://payment-service:5004/"
          }
        }
      },
      "communication-cluster": {
        "Destinations": {
          "communication-1": {
            "Address": "http://communication-service:5005/"
          }
        }
      },
      "reviews-cluster": {
        "Destinations": {
          "reviews-1": {
            "Address": "http://reviews-service:5006/"
          }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search-1": {
            "Address": "http://search-service:5007/"
          }
        }
      }
    }
  }
}